# ============================================================
# FootballHub Analyst Studio — environment variables
# ============================================================
# Copy this file to .env (or add these in the Vercel dashboard).
# Nothing here is required for the EXISTING FootballHub site to keep
# working: missing values simply disable the related feature.
#
# Discovery order is YouTube-first. The football-data API is an
# OPTIONAL SECONDARY source; a failure there never breaks discovery.

# ---- Legacy key (still honoured, now optional) ----
API_FOOTBALL_KEY=e580eab63d67375ef31ce591662bcfe8

# ---- YouTube Data API (PRIMARY discovery source) ----
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=

# ---- Football-data API (OPTIONAL secondary source) ----
FOOTBALL_API_KEY=
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io

# ---- AI reasoning ----
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_API_BASE_URL=https://api.openai.com/v1

# ---- Database / cache ----
DATABASE_URL=
# Optional cross-instance cache on Vercel (Upstash Redis REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional shared secret required for admin mutations in production.
STUDIO_WRITE_TOKEN=

# ---- Object storage (authorized footage uploads) ----
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---- Instagram publishing ----
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ---- FootballHub public base URL (the funnel target) ----
# Official website (Vercel); the Analyst Studio admin runs on Netlify.
FOOTBALLHUB_BASE_URL=https://footballhubstudio-git-main-flash-scarcity.vercel.app

# ---- API cost control / polling (all optional, sane defaults) ----
# Cache TTLs in minutes.
YOUTUBE_SEARCH_TTL_MINUTES=10
YOUTUBE_VIDEO_TTL_MINUTES=30
YOUTUBE_CHANNEL_TTL_MINUTES=60
YOUTUBE_UPLOADS_TTL_MINUTES=20
# Polling intervals in seconds (changeable from configuration).
YOUTUBE_POLL_LATEST_SECONDS=300
YOUTUBE_POLL_CHANNEL_SECONDS=900
# Search defaults.
YOUTUBE_DEFAULT_MAX_RESULTS=12
YOUTUBE_DEFAULT_REGION=GB
YOUTUBE_DEFAULT_LANGUAGE=en